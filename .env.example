# VPN Simulator 环境变量配置

# 服务器配置
VPN_SIM_SERVER_HOST=0.0.0.0
VPN_SIM_SERVER_PORT=8080

# 数据库配置（异步引擎，需使用 aiosqlite 方言）
VPN_SIM_DATABASE_URL=sqlite+aiosqlite:///vpn_simulator.db

# API 认证（可选）：设置后除 /health、/docs 等公开路径外均需 X-API-Key 请求头
# VPN_SIM_API_KEY=change-me

# 日志配置
VPN_SIM_LOG_LEVEL=INFO
VPN_SIM_LOG_FORMAT=json

# 国际化配置
VPN_SIM_LOCALE=zh-CN

# 平台配置 (auto/windows/darwin/linux)
VPN_SIM_PLATFORM=auto
